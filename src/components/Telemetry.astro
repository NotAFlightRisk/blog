---
import {
  PUBLIC_CF_BEACON_TOKEN,
  PUBLIC_PLAUSIBLE_SCRIPT,
  PUBLIC_SENTRY_DSN,
} from 'astro:env/client';

// all three are build-time and empty by default, so forks and previews never phone home
---

{PUBLIC_CF_BEACON_TOKEN && <script>
  import { PUBLIC_CF_BEACON_TOKEN as token } from 'astro:env/client';
  import { loadWhenSeen } from '../scripts/seen';

  loadWhenSeen('https://static.cloudflareinsights.com/beacon.min.js', {
    cfBeacon: JSON.stringify({ token }),
  });
</script>}

{PUBLIC_PLAUSIBLE_SCRIPT && <script>
  import { PUBLIC_PLAUSIBLE_SCRIPT as src } from 'astro:env/client';
  import { loadWhenSeen } from '../scripts/seen';

  declare global {
    interface Window {
      plausible: { init(options: { endpoint: string }): void };
    }
  }

  loadWhenSeen(src!).then(() =>
    window.plausible.init({ endpoint: new URL('/api/event', src).href }),
  );
</script>}

{PUBLIC_SENTRY_DSN && <script>
  // the SDK only downloads once something's actually broken, so pages that work never pay
  let sentry: Promise<(error: unknown) => void> | undefined;
  const report = (error: unknown) => {
    sentry ??= import('../scripts/sentry').then(({ start }) => start()).catch(() => () => {});
    sentry.then((capture) => capture(error));
  };
  addEventListener('error', (event) => event.error && report(event.error));
  addEventListener('unhandledrejection', (event) => report(event.reason));
</script>}
