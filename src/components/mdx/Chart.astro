---
import Axis from '../Axis.astro';
import ChartFrame from '../ChartFrame.astro';
import { columns, formatter, scale, type Rows } from '../../lib/rows';

interface Props {
  title: string;
  data: Rows;
  type?: 'bars' | 'columns' | 'line';
  unit?: string;
}

const { title, data, type = 'bars', unit = '' } = Astro.props;
const { label, series, max } = columns('Chart', title, data);
if (series.length > (type === 'line' ? 4 : 1)) {
  throw new Error(
    `Chart "${title}" has too many columns, bars and columns take one, lines up to four`,
  );
}
if (type === 'line' && data.length < 2) {
  throw new Error(`Chart "${title}" needs two rows or more to draw a line`);
}

const format = formatter(unit);
const { top, ticks } = scale(max);

const last = data.length - 1;
// columns put their label under the middle of each bar, lines run edge to edge
const x = (index: number) =>
  type === 'columns' ? ((index + 0.5) / data.length) * 100 : last ? (index / last) * 100 : 50;
const y = (value: number) => 100 - (value / top) * 100;
// every label along the bottom while they fit, then every nth, always ending on the last
const every = data.length > 7 ? Math.ceil(last / 5) : 1;
const shown = data
  .map((_, index) => index)
  .filter((index) => index === last || (index % every === 0 && last - index >= every / 2));

// names sit at the end of their line, nudged apart so they never overlap
const ends = series
  .map((name, index) => ({ name, index, at: y(Number(data[last][name])) }))
  .sort((a, b) => a.at - b.at);
ends.forEach((end, index) => {
  if (index) end.at = Math.max(end.at, ends[index - 1].at + 10);
});
const overflow = Math.max(0, (ends.at(-1)?.at ?? 0) - 100);
ends.forEach((end) => (end.at = Math.max(0, end.at - overflow)));
---

<ChartFrame {title} {unit} table={type === 'bars' ? undefined : data}>
  <slot slot="caption" />
  {type === 'bars' ? (
    <ul class="bars" role="list" data-pagefind-ignore>
      {data.map((row) => (
        <li>
          <span>{row[label]}</span>
          <span class="track">
            <span class="fill" style={`--size: ${(Number(row[series[0]]) / max) * 100}%`} />
          </span>
          <span class="value">{format(Number(row[series[0]]))}</span>
        </li>
      ))}
    </ul>
  ) : (
    <div
      class:list={['plot', { named: series.length > 1 }]}
      aria-hidden="true"
      data-pagefind-ignore
    >
      <Axis side="y" ticks={ticks.map((tick) => ({ at: y(tick), text: format(tick) }))} />
      <svg viewBox="0 0 100 100" preserveAspectRatio="none" height="200">
        {ticks.map((tick) => (
          <line class="grid" x1="0" x2="100" y1={y(tick)} y2={y(tick)} />
        ))}
        {type === 'line' &&
          series.map((name, index) => (
            <polyline
              fill="none"
              stroke="currentColor"
              points={data.map((row, at) => `${x(at)},${y(Number(row[name]))}`).join(' ')}
              style={`--colour: var(--series-${index + 1})`}
            />
          ))}
      </svg>
      {type === 'columns' && (
        <div class="columns">
          {data.map((row) => (
            <span class="fill" style={`--size: ${100 - y(Number(row[series[0]]))}%`} />
          ))}
        </div>
      )}
      {series.length > 1 && (
        <div class="names">
          {ends.map(({ name, index, at }) => (
            <span style={`--y: ${at}%; --colour: var(--series-${index + 1})`}>{name}</span>
          ))}
        </div>
      )}
      <Axis
        side="x"
        ticks={shown.map((index) => ({ at: x(index), text: String(data[index][label]) }))}
      />
    </div>
  )}
</ChartFrame>

<style>
  .bars {
    display: grid;
    grid-template-columns: fit-content(40%) 1fr auto;
    gap: var(--space-xs) var(--space-s);
    margin: 0;
    padding: 0;
    list-style: none;

    & li {
      display: grid;
      grid-column: 1 / -1;
      grid-template-columns: subgrid;
      align-items: center;
      margin: 0;
    }
  }

  /* the number's printed alongside, so the bar can be the brand yellow on either theme */
  .fill {
    display: block;
    width: var(--size);
    height: 1.25em;
    border-radius: var(--radius);
    background: var(--accent);
    box-shadow: var(--button-shadow);
  }

  .value {
    text-align: right;
  }

  .plot {
    display: grid;
    grid-template-columns: max-content 1fr;
    column-gap: var(--space-s);
    padding-top: 0.75em;

    &.named {
      grid-template-columns: max-content 1fr max-content;
    }

    /* the columns stand on the svg's gridlines */
    & svg,
    & .columns {
      grid-area: 1 / 2;
      width: 100%;
      height: 14rem;
    }

    & svg {
      overflow: visible;
    }
  }

  .columns {
    display: grid;
    grid-auto-columns: 1fr;
    grid-auto-flow: column;
    grid-template-rows: 100%;
    align-items: end;
    column-gap: var(--space-2xs);

    & .fill {
      width: auto;
      height: var(--size);
    }
  }

  .grid {
    stroke: var(--border);
    vector-effect: non-scaling-stroke;
  }

  polyline {
    fill: none;
    stroke: var(--colour);
    stroke-width: 2.5;
    stroke-linejoin: round;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  /* line names share one cell, slid down to the height their line ends at */
  .names {
    display: grid;
    grid-area: 1 / 3;
    grid-template-rows: 100%;
    line-height: 1.4;

    & span {
      grid-area: 1 / 1;
      align-self: start;
      position: relative;
      top: var(--y);
      translate: 0 -50%;
      color: var(--colour);
      font-weight: var(--weight-strong);
    }
  }
</style>
