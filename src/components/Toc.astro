---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
// a fold on a phone and an open list in the rail, and only one of them is ever shown
---

<nav class="toc" aria-label="Contents">
  <details>
    <summary>
      Contents
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m9 6 6 6-6 6"></path>
      </svg>
    </summary>
    <ol>
      {headings.map(({ depth, slug, text }) => (
        <li class:list={{ sub: depth > 2 }}>
          <a href={`#${slug}`}>{text}</a>
        </li>
      ))}
    </ol>
  </details>
  <div>
    <p>Contents</p>
    <ol>
      {headings.map(({ depth, slug, text }) => (
        <li class:list={{ sub: depth > 2 }}>
          <a href={`#${slug}`}>{text}</a>
        </li>
      ))}
    </ol>
  </div>
</nav>

<script>
  // the section being read is the last whose heading's scrolled up to where a click here lands it
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  const hrefs = [...new Set(links.map((link) => link.getAttribute('href')!))];
  const headings = hrefs.map((href) => document.getElementById(href.slice(1))!);
  const { scrollPaddingTop } = getComputedStyle(document.documentElement);
  const { scrollMarginTop } = getComputedStyle(headings[0]);
  const line = parseFloat(scrollPaddingTop) + parseFloat(scrollMarginTop) + 1;

  function mark() {
    const current =
      hrefs[headings.findLastIndex((heading) => heading.getBoundingClientRect().top < line)];
    for (const link of links) {
      link.ariaCurrent = link.getAttribute('href') === current ? 'location' : null;
    }
  }

  addEventListener('scroll', mark, { passive: true });
  mark();
</script>

<style>
  details {
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--panel-shadow);

    & ol {
      margin: 0 var(--space-m) var(--space-s);
    }
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-xs) var(--space-m);
    font-weight: var(--weight-title);
    letter-spacing: var(--tracking-title);
    list-style: none;
    cursor: pointer;

    &::-webkit-details-marker {
      display: none;
    }
  }

  svg {
    width: var(--icon-small);
    height: var(--icon-small);
  }

  [open] svg {
    rotate: 90deg;
  }

  /* a label like the rest of the rail's, quiet so the headings under it stand out */
  p {
    margin: 0;
    color: var(--text-muted);
  }

  div {
    display: none;
  }

  /* a track down the side, with the section being read marked on it */
  ol {
    display: grid;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    border-left: var(--separator);
    list-style: none;
  }

  a {
    display: block;
    margin-left: -1px;
    padding: var(--space-3xs) 0 var(--space-3xs) var(--space-s);
    border-left: var(--underline) solid transparent;
    text-decoration: none;

    &:hover {
      text-decoration: underline;
      text-decoration-color: var(--accent);
    }

    &[aria-current] {
      border-color: var(--accent);
    }
  }

  .sub a {
    padding-left: var(--space-l);
  }

  @media (prefers-reduced-motion: no-preference) {
    svg {
      transition: rotate var(--quick) var(--ease);
    }

    a {
      transition: border-color var(--quick) var(--ease);
    }
  }

  @media (width >= 64rem) {
    details {
      display: none;
    }

    div {
      display: grid;
      gap: var(--space-2xs);
    }
  }
</style>
