{
  "name": "blog",
  "version": "0.1.0",
  "private": true,
  "description": "The peng.ly blog",
  "homepage": "https://blog.peng.ly",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "charts": "node scripts/chart-images.ts",
    "crosspost": "node scripts/crosspost.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "format": "prettier --write src scripts astro.config.ts vercel.json .github/workflows",
    "format:check": "prettier --check src scripts astro.config.ts vercel.json .github/workflows"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@sentry/browser": "^11.7.0",
    "@shikijs/transformers": "^4.5.0",
    "astro": "^7.3.8",
    "rehype-autolink-headings": "^7.1.0",
    "satori": "^0.56.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "pagefind": "^1.5.2",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "fflate": "^0.7.5"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100,
    "plugins": [
      "prettier-plugin-astro"
    ],
    "overrides": [
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      }
    ]
  }
}
