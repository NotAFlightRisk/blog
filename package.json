{
  "name": "blog",
  "version": "0.1.0",
  "private": true,
  "description": "The peng.ly blog",
  "homepage": "https://blog.peng.ly",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist && node scripts/pdf-copies.ts",
    "preview": "astro preview",
    "check": "astro check",
    "charts": "node scripts/chart-images.ts",
    "crosspost": "node scripts/crosspost.ts",
    "indexnow": "node scripts/indexnow.ts",
    "og": "node scripts/og-cards.ts",
    "readme": "node scripts/readme.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "format": "prettier --write src scripts astro.config.ts vercel.json .github/workflows",
    "format:check": "prettier --check src scripts astro.config.ts vercel.json .github/workflows"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.9",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.5",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@sentry/browser": "^11.13.0",
    "@shikijs/transformers": "^4.6.0",
    "astro": "^7.4.12",
    "rehype-autolink-headings": "^7.1.0",
    "satori": "^0.63.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@sparticuz/chromium": "^153.0.0",
    "pagefind": "^1.6.0",
    "playwright-core": "^1.65.1",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "fflate": "^0.7.5"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100,
    "plugins": [
      "prettier-plugin-astro"
    ],
    "overrides": [
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      }
    ]
  }
}
