---
import { Font } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/base.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Telemetry from '../components/Telemetry.astro';
import { absolute } from '../lib/posts';
import { themeScript } from '../lib/theme';
import { site } from '../site';

interface Props {
  title?: string;
  description?: string;
  image?: { src: string; alt: string };
  article?: { published: Date; modified?: Date; tags: string[] };
  schema?: object[];
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  image = { src: '/og.png', alt: `${site.name}, in big letters next to a cartoon penguin` },
  article,
  schema = [],
  noindex = false,
} = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : site.name;
const canonical = absolute(Astro.url.pathname);
const graph = JSON.stringify({ '@context': 'https://schema.org', '@graph': schema });
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={themeScript} />
    <Font cssVariable="--font-sans" preload />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="author" content={site.author.name} />
    <meta name="theme-color" content={site.color} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absolute(image.src)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={image.alt} />
    {article && (
      <>
        <meta property="article:published_time" content={article.published.toISOString()} />
        {article.modified && (
          <meta property="article:modified_time" content={article.modified.toISOString()} />
        )}
        <meta property="article:author" content={site.author.url} />
        {article.tags.map((tag) => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? site.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absolute(image.src)} />
    {schema.length > 0 && <script type="application/ld+json" set:html={graph} />}
    <slot name="head" />
    <Telemetry />
  </head>
  <body>
    <a class="skip button" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip {
    position: fixed;
    top: var(--space-xs);
    left: var(--space-xs);
    z-index: 2;
    background: var(--on-accent);
    color: var(--accent);
    translate: 0 -200%;

    &:focus-visible {
      translate: none;
    }
  }

  main:focus {
    outline: none;
  }
</style>
