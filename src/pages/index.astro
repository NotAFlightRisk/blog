---
import Intro from '../components/Intro.astro';
import PostList from '../components/PostList.astro';
import Base from '../layouts/Base.astro';
import { absolute, getPosts } from '../lib/posts';
import { featured, latest, site } from '../site';

const posts = await getPosts();
const picks = posts
  .slice(latest)
  .filter(({ data }) => data.featured)
  .slice(0, featured);
const shown = [...posts.slice(0, latest), ...picks];
const url = absolute('/');
const schema = [
  { '@type': 'WebSite', name: site.name, url, inLanguage: site.lang },
  {
    '@type': 'Blog',
    name: site.name,
    url,
    description: site.description,
    inLanguage: site.lang,
    author: { '@type': 'Person', name: site.author.name, url: site.author.url },
    isPartOf: { '@type': 'WebSite', name: site.home.name, url: site.home.url },
  },
];
---

<Base {schema}>
  <Intro title="Blog">
    {site.description}. Follow along with <a href="/rss.xml">RSS</a>.
  </Intro>
  {posts.length ? <PostList posts={shown} /> : <p>Nothing here yet. Noot.</p>}
  {posts.length > shown.length && (
    <p class="more">
      <a class="button raised" href="/archive/">
        All {posts.length} posts
      </a>
    </p>
  )}
</Base>

<style>
  .more {
    margin: var(--space-2xl) 0 0;
  }
</style>
