---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  title: string;
  youtube?: string;
  src?: string;
  poster?: ImageMetadata;
}

const { title, youtube, src, poster } = Astro.props;
if (!youtube === !src) throw new Error(`<Video title="${title}"> wants a youtube id or a src`);
const href = youtube ? `https://www.youtube.com/watch?v=${youtube}` : src;
---

<figure>
  <a class="facade" {href} data-youtube={youtube} data-video={src} data-pagefind-ignore>
    {youtube ? (
      // fetched at build time and served from here, so YouTube hears nothing until you press play
      <Image src={`https://i.ytimg.com/vi/${youtube}/hqdefault.jpg`} alt="" inferSize />
    ) : (
      poster && <Image src={poster} alt="" />
    )}
    <span class="play">
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M8 5.5v13l10.5-6.5z" fill="currentColor" />
      </svg>
      <span>
        Play <span class="visually-hidden">{title}</span>
      </span>
    </span>
  </a>
  <figcaption>{title}</figcaption>
</figure>

<script>
  // the player only turns up once you press play, and YouTube's is the no-cookie one
  for (const link of document.querySelectorAll<HTMLAnchorElement>('a.facade')) {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      const { youtube, video } = link.dataset;
      const player = youtube
        ? Object.assign(document.createElement('iframe'), {
            src: `https://www.youtube-nocookie.com/embed/${youtube}?autoplay=1`,
            allow: 'autoplay; encrypted-media; picture-in-picture; fullscreen',
            allowFullscreen: true,
          })
        : Object.assign(document.createElement('video'), {
            src: video,
            controls: true,
            autoplay: true,
            playsInline: true,
          });
      player.title = link.closest('figure')?.querySelector('figcaption')?.textContent ?? 'Video';
      link.replaceWith(player);
      player.focus();
    });
  }
</script>

<style>
  figure {
    display: grid;
    gap: var(--space-xs);
    margin: var(--space-l) 0;
  }

  .facade,
  figure :global(:is(iframe, video)) {
    position: relative;
    display: grid;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 0;
    border-radius: var(--radius);
    background: var(--on-accent);
    box-shadow: var(--panel-shadow);
  }

  .facade img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .play {
    position: absolute;
    place-self: center;
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-s) var(--space-l);
    border-radius: var(--radius);
    background: var(--accent);
    color: var(--on-accent);
    font-weight: var(--weight-title);
    box-shadow: var(--bar-shadow);
  }

  .facade:hover .play {
    box-shadow: var(--bar-shadow), var(--button-shadow);
  }

  figcaption {
    color: var(--text-muted);
    font-size: var(--text-small);
    text-align: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .play {
      transition: scale var(--quick) var(--ease);
    }

    .facade:hover .play {
      scale: 1.05;
    }
  }
</style>
