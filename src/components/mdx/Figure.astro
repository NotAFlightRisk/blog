---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
}

const { src, alt } = Astro.props;
// as wide as the reading column gets, and the srcset takes care of sharp screens
const width = Math.min(src.width, 720);
---

<figure>
  <Picture {src} {alt} {width} formats={['avif', 'webp']} />
  {Astro.slots.has('default') && (
    <figcaption>
      <slot />
    </figcaption>
  )}
</figure>

<style>
  figure {
    display: grid;
    gap: var(--space-xs);
    margin: var(--space-l) 0;
  }

  /* the hairline keeps an edge on a screenshot that's the same colour as the page */
  figure :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    box-shadow:
      var(--panel-shadow),
      0 0 0 1px var(--border);
  }

  figcaption {
    color: var(--text-muted);
    font-size: var(--text-small);
    text-align: center;
    text-wrap: balance;

    & :global(p) {
      margin: 0;
    }
  }
</style>
