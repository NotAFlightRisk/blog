---
import Penguin from './Penguin.astro';
import Base from '../layouts/Base.astro';

interface Props {
  status: 404 | 500;
}

const pages = {
  404: {
    title: 'Noot found',
    description:
      "That's penguin for page not found. The link might be old, or the address might have a typo.",
  },
  500: {
    title: 'Noot working',
    description: 'Something broke on my end. Give it another go in a minute.',
  },
};

const { status } = Astro.props;
const { title, description } = pages[status];
// 404 and 500 both have a nought in the middle, so that's where he pops up
const [first, , last] = String(status);
---

<Base {title} {description} noindex>
  <div class="oops">
    <p role="img" aria-label={`Error ${status}`}>
      <span>{first}</span>
      <span class="zero">
        <Penguin />
      </span>
      <span>{last}</span>
    </p>
    <h1>{title}</h1>
    <p>{description}</p>
    <ul>
      <li>
        <a class="button raised" href="/">
          Latest posts
        </a>
      </li>
      <li>
        <a class="button raised" href="/archive/">
          Archive
        </a>
      </li>
      <li>
        <a class="button raised" href="/search/">
          Search
        </a>
      </li>
    </ul>
  </div>
</Base>

<style>
  .oops {
    display: grid;
    justify-items: start;
    gap: var(--space-m);

    @media (width >= 48rem) {
      padding-left: calc(var(--rail) + var(--gutter));
    }
  }

  [role='img'] {
    --penguin-size: 100%;
    display: flex;
    align-items: center;
    margin: 0;
    font-size: clamp(6rem, 30vw, 14rem);
    font-weight: var(--weight-title);
    line-height: var(--leading-brand);
    letter-spacing: var(--tracking-title);
  }

  /* a ring rather than the font's nought, so there's a hole for him to peek out of */
  .zero {
    display: flex;
    align-items: end;
    width: 0.6em;
    aspect-ratio: 0.875;
    margin-inline: 0.03em;
    overflow: hidden;
    border: 0.16em solid;
    border-radius: 50%;
    background: var(--accent);
  }

  .zero :global(svg) {
    fill: var(--on-accent);
  }

  h1 {
    margin: 0;
    font-size: var(--text-title);
  }

  p:not([role]) {
    max-width: var(--measure);
    margin: 0;
    color: var(--text-muted);
    font-size: var(--text-large);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }
</style>
