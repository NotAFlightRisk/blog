---
interface Props {
  by: string;
  href?: string;
}

const { by, href } = Astro.props;
---

<figure class="quote">
  <svg class="mark" viewBox="0 0 24 24" aria-hidden="true">
    <path
      d="M3 21v-7.5C3 8.4 5.6 5 10 4l.8 2C8.3 7 7 9 7 11h4v10zm10 0v-7.5C13 8.4 15.6 5 20 4l.8 2c-2.5 1-3.8 3-3.8 5h4v10z"
      fill="currentColor"
    ></path>
  </svg>
  <blockquote cite={href}>
    <slot />
  </blockquote>
  <figcaption>{href ? <a {href}>{by}</a> : by}</figcaption>
</figure>

<style>
  .quote {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-xs) var(--space-m);
    margin: var(--space-xl) 0;
  }

  .mark {
    width: var(--space-xl);
    height: var(--space-xl);
    color: var(--accent);
  }

  figure.quote blockquote {
    margin: 0;
    padding: 0;
    border: 0;
    color: var(--text);
    font-size: var(--text-large);
    font-weight: var(--weight-strong);
    letter-spacing: -0.01em;
    line-height: var(--leading);
    text-wrap: pretty;

    & :global(p) {
      margin: 0 0 var(--space-s);
    }

    & :global(p:last-child) {
      margin: 0;
    }
  }

  figcaption {
    grid-column: 2;
    color: var(--text-muted);
    font-size: var(--text-small);

    &::before {
      content: '- ';
    }
  }
</style>
