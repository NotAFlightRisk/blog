---
import Intro from '../components/Intro.astro';
import PostList from '../components/PostList.astro';
import Base from '../layouts/Base.astro';
import { formatMonth, isoDate } from '../lib/format';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
// newest first, so the months are too, each keyed by its yyyy-mm
const months = Map.groupBy(posts, ({ data }) => isoDate(data.date).slice(0, 7));
const intro =
  posts.length === 1
    ? 'Just the one post so far.'
    : `Every post so far, all ${posts.length} of them, newest first.`;
---

<Base title="Archive" description={`Every post on the blog, ${posts.length} so far, newest first.`}>
  <Intro title="Archive">{intro}</Intro>
  {[...months].map(([month, list], index) => (
    <section aria-labelledby={month}>
      <h2 id={month}>
        <time datetime={month}>{formatMonth(list[0].data.date)}</time>
      </h2>
      <PostList posts={list} heading={3} priority={index === 0} />
    </section>
  ))}
</Base>

<style>
  section + section {
    margin-top: var(--space-2xl);
  }

  h2 {
    margin: 0 0 var(--space-l);
    color: var(--text-muted);
    font-size: var(--text-h2);
    font-variant-numeric: tabular-nums;
  }
</style>
