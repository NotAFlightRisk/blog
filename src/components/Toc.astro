---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
---

<nav aria-labelledby="contents">
  <details>
    <summary id="contents">Contents</summary>
    <ol>
      {headings.map(({ depth, slug, text }) => (
        <li class:list={{ sub: depth > 2 }}>
          <a href={`#${slug}`}>{text}</a>
        </li>
      ))}
    </ol>
  </details>
</nav>

<style>
  details {
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--panel-shadow);
  }

  summary {
    padding: var(--space-xs) var(--space-m);
    font-weight: var(--weight-title);
    letter-spacing: var(--tracking-title);
    cursor: pointer;
  }

  ol {
    display: grid;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0 var(--space-m) var(--space-s);
    list-style: none;
    font-size: var(--text-small);
  }

  .sub {
    padding-left: var(--space-m);
  }

  a {
    display: block;
    padding-block: var(--space-3xs);
    color: var(--text-muted);
    text-decoration: none;

    &:hover {
      color: var(--text);
      text-decoration: underline;
      text-decoration-color: var(--accent);
    }
  }

  /* there's room in the rail on a wide screen, so it stays open and stops being a toggle */
  @media (width >= 64rem) {
    @supports selector(::details-content) {
      details {
        background: none;
        box-shadow: none;

        &::details-content {
          content-visibility: visible;
          display: contents;
        }
      }

      summary {
        padding-inline: 0;
        list-style: none;
        pointer-events: none;

        &::-webkit-details-marker {
          display: none;
        }
      }

      ol {
        padding-inline: 0;
      }
    }
  }
</style>
